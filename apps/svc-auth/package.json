{
  "name": "@r/svc-auth",
  "type": "module",
  "exports": {
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm run cf-gen-types && wrangler secret bulk .dev.vars.production && wrangler deploy --minify",
    "db:generate": "drizzle-kit generate",
    "cf-gen-types": "wrangler types --env-interface CloudflareBindings",
    "better-auth-gen-schema": " pnpm dlx @better-auth/cli generate --config src/libs/auth.ts --output src/db/schema/auth.ts",
    "db:migrate:local": "wrangler d1 migrations apply quote_app_svc_auth --local"
  },
  "dependencies": {
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.4.0"
  }
}
