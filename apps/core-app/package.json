{
  "name": "signin",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm cf-gen-types && astro dev",
    "build": "astro build",
    "deploy": "pnpm build && pnpm run cf-gen-types && wrangler secret bulk .dev.vars.production && wrangler deploy --minify",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "cf-gen-types": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply quote_app_core_db --local",
    "db:generate-seed": "bun tools/generate-seed.ts",
    "db:seed": "wrangler d1 execute quote_app_core_db --file=./seed.sql --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.3",
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@r/types": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.76.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19"
  }
}
