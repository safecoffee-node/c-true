---
import { Clock } from "@/components/clock.tsx";
import { Spinner } from "@/components/ui/spinner";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const paths = [];
  for (const year of [2025, 2026]) {
    for (let month = 1; month <= 12; month++) {
      const daysInMonth = new Date(year, month, 0).getDate();
      for (let day = 1; day <= daysInMonth; day++) {
        paths.push({ params: { date: `${year}-${month}-${day}` } });
      }
    }
  }
  return paths;
}

const { date } = Astro.params;
const [year, month, day] = date.split("-").map(Number);
const dateStr = `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;

const items = await getCollection("quotes");
const allCitations = items.flatMap((item) =>
  Object.values(item.data.themes).flatMap((t) => t.citations),
);

const quote = allCitations.find((c) => c.publishAt.includes(dateStr));
const today = new Date().toISOString().split("T")[0];

const currentDate = new Date(dateStr).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const locale = Astro.currentLocale ?? "en";
const timeZone = (Astro.request.cf?.timezone as string) ?? "UTC";
---

<Layout>
  <article class="flex flex-col gap-8 md:pb-64">
    <header>
      <div class="flex items-center gap-2">
        <h1 class="font-medium">
          {quote?.source_originale ? quote?.source_originale : quote?.source}
        </h1>
      </div>
      <div class="flex flex-col">
        <time class="text-muted-foreground">
          {
            new Intl.DateTimeFormat("en-US", {
              timeZone: (Astro.request.cf?.timezone as string) ?? "UTC",
              month: "long",
              day: "numeric",
              year: "numeric",
            }).format(new Date(currentDate))
          }
        </time>
        <Clock locale={locale} timeZone={timeZone} client:only="react">
          <div slot="fallback">
            <div
              data-slot="skeleton"
              class="w-[90px] h-[20px] animate-pulse rounded bg-muted"
            >
            </div>
          </div>
        </Clock>
      </div>
    </header>
    <div class="prose prose-neutral dark:prose-invert ...">
      <div class="grid grid-cols-1 gap-50">
        <div class="flex flex-col">
          <p
            class="text-foreground mb-6 font-serif text-[17px] leading-[26px] font-light"
          >
            {quote?.citation_originale}
          </p>
          <p class="text-right font-serif text-muted-foreground">
            — {quote?.auteur}.
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
