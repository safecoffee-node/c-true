---
import { Spinner } from "@/components/ui/spinner";
import Layout from "@/layouts/Layout.astro";
import { Browse } from "@/components/browse.tsx";
---

<Layout>
  <div class="m-auto flex flex-col items-center justify-center gap-10">
    <nav>
      <ul>
        <li class="text-sm">
          <a href="/browse/full-text" class="after:hidden">full-text</a>
        </li>
      </ul>
    </nav>
    <Browse client:only="react">
      <div slot="fallback">
        <Spinner />
      </div>
    </Browse>
  </div>
</Layout>
