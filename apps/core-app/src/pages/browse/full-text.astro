---
import Layout from "@/layouts/Layout.astro";
import { cleanBody } from "@/lib/daily-wisdom.ts";
import { render } from "astro:content";
import { getCollection } from "astro:content";
const docs = await getCollection("daily-wisdom");
const today = new Date().toISOString().split("T")[0];
const currentDate = today;
const locale = Astro.currentLocale ?? "en";

const entries = await Promise.all(
  docs.map(async (item) => {
    const { Content } = await render(item);
    return { item, Content };
  }),
);
---

<Layout>
  <div class="divide divide-y">
    {
      entries.map(({ item, Content }) => (
        <article class="flex flex-col gap-8 pt-10 md:pb-15">
          <div class="w-full flex items-center justify-center">
            <time>
              {new Intl.DateTimeFormat(locale, {
                timeZone: (Astro.request.cf?.timezone as string) ?? "UTC",
                month: "long",
                day: "numeric",
              }).format(new Date(item.data.pubDate))}
            </time>
          </div>
          <header class="flex flex-col gap-2">
            <div class="flex items-center text-xl text-balance text-center justify-center gap-2">
              {item?.data.title ? (
                <h1 class="font-medium">{item?.data.title}</h1>
              ) : (
                <h1 class="font-medium">{item?.data.source}</h1>
              )}
            </div>
          </header>
          <div class="prose prose-neutral dark:prose-invert prose-figcaption:text-muted-foreground prose-figcaption:-mt-3 prose-figcaption:mb-8 prose-figcaption:max-w-xl prose-figcaption:text-sm prose-img:mt-2 prose-ul:font-serif max-w-none text-foreground mb-6 font-serif text-pretty text-[17px] leading-[26px] font-light">
            <Content />
          </div>

          <aside class="flex flex-col gap-2">
            {item.data.location && (
              <span class="text-primary/50 text-sm leading-[26px]">
                {item.data.location}
              </span>
            )}
          </aside>
        </article>
      ))
    }
  </div>
</Layout>
