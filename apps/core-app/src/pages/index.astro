---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Clock } from "@/components/clock.tsx";
import { Spinner } from "@/components/ui/spinner.tsx";
import { Skeleton } from "@/components/ui/skeleton.tsx";
import TimeFormat from "@/components/TimeFormat.astro";

export async function getDailyItem() {
  const items = await getCollection("quotes");
  const flattensItems = items.flatMap((item) =>
    Object.values(item.data.themes).flatMap((t) => t.citations),
  );
  const today = new Date().toISOString().split("T")[0];
  return flattensItems.find((c) => c.publishAt.includes(today));
}
const item = await getDailyItem();
const today = new Date().toISOString().split("T")[0];
const currentDate = item?.publishAt.find((d) => d === today);
const locale = Astro.currentLocale ?? "en";
---

<Layout>
  <article class="flex flex-col gap-8 md:pb-64">
    <header class="flex flex-col gap-2">
      <div class="flex items-center gap-2">
        <h1 class="font-medium font-serif">
          {item?.source_originale ? item?.source_originale : item?.source}
        </h1>
      </div>
      <div class="flex flex-col">
        <time>
          {
            new Intl.DateTimeFormat(locale, {
              timeZone: (Astro.request.cf?.timezone as string) ?? "UTC",
              month: "long",
              day: "numeric",
              year: "numeric",
            }).format(new Date(currentDate ?? 0))
          }
        </time>
        <TimeFormat />
      </div>
      <div
        class="prose prose-neutral dark:prose-invert prose-figcaption:text-muted-foreground prose-figcaption:-mt-3 prose-figcaption:mb-8 prose-figcaption:max-w-xl prose-figcaption:text-sm prose-img:mt-2 prose-ul:font-serif max-w-none"
      >
        <div class="grid grid-cols-1 gap-50">
          <div class="flex flex-col">
            <p
              class="text-foreground mb-6 font-serif text-[17px] leading-[26px] font-light"
            >
              {item?.citation}
            </p>
            <p class="text-right font-serif text-muted-foreground">
              — {item?.auteur}.
            </p>
          </div>
        </div>
      </div>
    </header>
  </article>
</Layout>
