---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    class="prose prose-neutral dark:prose-invert prose-figcaption:text-muted-foreground prose-figcaption:-mt-3 prose-figcaption:mb-8 prose-figcaption:max-w-xl prose-figcaption:text-sm prose-img:mt-2 prose-ul:font-serif max-w-none"
  >
    <p
      class="text-foreground mb-6 font-serif text-[17px] leading-[26px] font-light"
    >
      Singin is a collection of 400 quotes gathered from philosophers, poets,
      and thinkers across centuries and continents — a different voice every
      day. The idea is simple : one quote, every morning.
    </p>

    <p class="text-foreground font-serif text-[17px] leading-[26px] font-light">
      If you have a correction or a suggestion <a
        class="text-foreground no-underline"
        href="mailto:emmanuelito.mboussa@eembouz.com"
        >emmanuelito.mboussa@eembouz.com</a
      >
    </p>
  </div>
</Layout>
