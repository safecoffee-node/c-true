---
import { Button } from "./ui/button.tsx";

const mainPage = Astro.url.pathname === "/";
console.log(mainPage);
---

<header>
  <div class="relative">
    <nav class="gap-4 border-b pb-2.5">
      <div class="font-serif m-auto font-light text-[2rem]">
        <a class="after:!content-none" href="/">
          {
            !mainPage ? (
              <Button
                className="group border-none cursor-pointer"
                variant="ghost"
              >
                <svg
                  class="text-muted-foreground group-hover:text-primary"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-corner-left-down-icon lucide-corner-left-down"
                >
                  <>
                    <path d="m14 15-5 5-5-5" />
                    <path d="M20 4h-7a4 4 0 0 0-4 4v12" />
                  </>
                </svg>
              </Button>
            ) : (
              <Button
                className="group border-none cursor-pointer"
                variant="ghost"
              >
                <svg
                  class="text-muted-foreground group-hover:text-primary"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-refresh-cw-icon lucide-refresh-cw"
                >
                  <>
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                    <path d="M21 3v5h-5" />
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                    <path d="M8 16H3v5" />
                  </>
                </svg>
              </Button>
            )
          }
        </a>
      </div>
    </nav>
  </div>
</header>
