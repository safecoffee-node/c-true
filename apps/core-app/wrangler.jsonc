{
  "compatibility_date": "2026-03-22",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "c-true",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "services": [{ "binding": "SVC_AUTH", "service": "svc-auth" }],
}
